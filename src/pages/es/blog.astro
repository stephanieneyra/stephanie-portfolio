---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Tag from '../../components/Tag.astro';
import { useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { blogCategoryLabel } from '../../content/blogCategories';

const lang = 'es' as const;
const t = useTranslations(lang);

const articles = (await getCollection('blog'))
  .filter((a) => a.data.lang === lang && a.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticle = articles.find((a) => a.data.featured) ?? articles[0];
const secondaryArticles = articles.filter((a) => a.id !== featuredArticle?.id).slice(0, 4);

const dateFormatter = new Intl.DateTimeFormat('es-PE', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BlogLayout lang={lang} title={t('nav.blog')} description={t('blog.subtitle')}>
  <section class="section wrap blog-hero">
    <span class="eyebrow">{t('blog.eyebrow')}</span>
    <h1>{t('blog.title')}</h1>
    <p>{t('blog.subtitle')}</p>
  </section>

  <hr class="divider" />

  <section class="section wrap two-col">
    <div class="panel">
      <span class="eyebrow">{t('blog.newsletterEyebrow')}</span>
      <h2>{t('blog.newsletterTitle')}</h2>
      <p>{t('blog.newsletterBody')}</p>
      <div class="kit-embed">
        <script async data-uid="e99c1884dc" src="https://stephanie-neyra.kit.com/e99c1884dc/index.js"></script>
      </div>
    </div>

    <div class="panel">
      <span class="eyebrow">{t('blog.mediumEyebrow')}</span>
      <h2>{t('blog.mediumTitle')}</h2>
      <p>{t('blog.mediumBody')}</p>
      <a href="https://medium.com/@stephneyraco" target="_blank" rel="noopener noreferrer" class="btn btn-outline">{t('blog.mediumCta')}</a>
    </div>
  </section>

  <hr class="divider" />

  <section class="section wrap">
    <h2 class="section-title">{t('blog.latestArticles')}</h2>

    {articles.length === 0 ? (
      <p class="empty-state">Los artículos están en camino — vuelve pronto, o sígueme mientras tanto en Medium.</p>
    ) : (
      <div class="articles-layout">
        {featuredArticle && (
          <a href={featuredArticle.data.externalUrl} target="_blank" rel="noopener noreferrer" class="featured-card">
            <Tag>{blogCategoryLabel(featuredArticle.data.category, lang)}</Tag>
            <h3>{featuredArticle.data.title}</h3>
            <p>{featuredArticle.data.description}</p>
            <span class="read-link">{t('blog.readArticle')} &rarr;</span>
            <span class="date">{dateFormatter.format(featuredArticle.data.date)}</span>
          </a>
        )}
        <div class="secondary-grid">
          {secondaryArticles.map((a) => (
            <a href={a.data.externalUrl} target="_blank" rel="noopener noreferrer" class="secondary-card">
              <Tag variant="muted">{blogCategoryLabel(a.data.category, lang)}</Tag>
              <h4>{a.data.title}</h4>
              <span class="read-link">{t('blog.readArticle')} &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="view-all-wrap">
      <a href="https://medium.com/@stephneyraco" target="_blank" rel="noopener noreferrer" class="view-all">{t('blog.viewAllArticles')} &rarr;</a>
    </div>
  </section>
</BlogLayout>

<style>
  .blog-hero {
    padding-top: 72px;
    max-width: 680px;
  }

  .blog-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-top: 12px;
  }

  .blog-hero p {
    margin-top: 20px;
    font-size: 17px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  @media (max-width: 720px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }

  .panel h2 {
    font-size: 22px;
    margin-top: 8px;
  }

  .panel p {
    margin-top: 12px;
    font-size: 15px;
  }

  .kit-embed {
    margin-top: 20px;
  }

  .panel :global(a.btn) {
    margin-top: 20px;
  }

  .section-title {
    font-size: 24px;
    margin-bottom: 32px;
  }

  .empty-state {
    color: var(--color-gray);
    font-size: 15px;
  }

  .articles-layout {
    display: grid;
    gap: 24px;
  }

  .featured-card {
    display: block;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    text-decoration: none;
  }

  .featured-card h3 {
    font-size: 24px;
    margin-top: 16px;
  }

  .featured-card p {
    margin-top: 10px;
    font-size: 15px;
  }

  .featured-card .date {
    display: block;
    margin-top: 16px;
    font-size: 13px;
    color: var(--color-gray);
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 640px) {
    .secondary-grid {
      grid-template-columns: 1fr;
    }
  }

  .secondary-card {
    display: block;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .secondary-card h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 17px;
    margin-top: 12px;
    color: var(--color-ink);
  }

  .read-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--color-ink);
  }

  .view-all-wrap {
    margin-top: 40px;
    text-align: center;
  }

  .view-all {
    font-size: 14px;
    text-decoration: none;
    color: var(--color-ink);
  }
</style>


