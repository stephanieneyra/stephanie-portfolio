---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Tag from '../../../components/Tag.astro';
import { getCollection } from 'astro:content';
import { categoryLabel } from '../../../content/categories';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.lang === 'es' && p.data.published);
  return projects.map((p) => ({
    params: { slug: p.data.slug },
    props: { entry: p }
  }));
}

const { entry } = Astro.props;
const { data, render } = entry;
const { Content } = await render();

const sections = [
  ['Problema', data.problem],
  ['Fuente de datos', data.dataSource],
  ['Análisis', data.analysis],
  ['Solución', data.solution],
  ['Resultados e impacto', data.results]
];
---
<BaseLayout lang="es" title={data.title} description={data.summary}>
  <article class="section wrap case-study">
    <a href="/es/projects" class="back-link">&larr; Todos los proyectos</a>
    <Tag>{categoryLabel(data.category, 'es')}</Tag>
    <h1>{data.title}</h1>
    <p class="summary">{data.summary}</p>

    {data.image && <img src={data.image} alt={data.title} class="case-image" />}

    <div class="case-sections">
      {sections.map(([label, value]) => (
        <div class="case-section">
          <h2>{label}</h2>
          <p>{value}</p>
        </div>
      ))}
    </div>

    <div class="tools">
      <h2>Herramientas</h2>
      <div class="tools-list">
        {data.tools.map((tool) => <Tag variant="muted">{tool}</Tag>)}
      </div>
    </div>

    <div class="case-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-top: 64px;
    max-width: 760px;
  }

  .back-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-gray);
    text-decoration: none;
    margin-bottom: 24px;
  }

  .case-study h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-top: 16px;
  }

  .summary {
    margin-top: 16px;
    font-size: 17px;
  }

  .case-image {
    width: 100%;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    margin-top: 32px;
  }

  .case-sections {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .case-section h2 {
    font-size: 18px;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .case-section p {
    margin-top: 8px;
    max-width: 68ch;
  }

  .tools {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .tools h2 {
    font-size: 18px;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .tools-list {
    margin-top: 12px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .case-body {
    margin-top: 40px;
  }
</style>
