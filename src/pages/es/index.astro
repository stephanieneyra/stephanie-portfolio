---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingDots from '../../components/FloatingDots.astro';
import Button from '../../components/Button.astro';
import Tag from '../../components/Tag.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);

// Datos de ejemplo, marcados provisional=true — reemplazar con los casos de
// negocio reales cuando estén listos, y luego cambiar provisional a false.
const featuredProjects = [
  {
    category: 'Business Intelligence & Dashboards',
    title: 'Dashboard de ventas retail',
    description: 'Panel ejecutivo para detectar tendencias, caídas de desempeño y oportunidades comerciales en ventas retail.',
    href: '/es/projects/retail-sales-dashboard',
    provisional: false
  },
  {
    category: 'Forecasting e Inventarios',
    title: 'Modelo de forecast de demanda',
    description: 'Modelo de pronóstico para reducir quiebres de stock y sobreinventario a partir del historial de ventas.',
    href: '/es/projects/demand-forecast-model',
    provisional: false
  },
  {
    category: 'Marketing Analytics',
    title: 'Segmentación de clientes',
    description: 'Segmentación basada en datos para reemplazar campañas genéricas con acciones de marketing dirigidas.',
    href: '/es/projects/customer-segmentation',
    provisional: false
  }
];

const recentArticles: { title: string; category: string }[] = [];
---
<BaseLayout lang={lang} title="Home" description={t('hero.subtitle')}>
  <section class="hero section">
    <FloatingDots />
    <div class="wrap hero-inner">
      <span class="eyebrow">Marketing &middot; Datos &middot; Supply Chain</span>
      <p class="hero-name">Stephanie Neyra</p>
      <h1 class="hero-title">{t('hero.title')}</h1>
      <p class="hero-subtitle">{t('hero.subtitle')}</p>
      <div class="hero-actions">
        <Button href="/es/projects">{t('hero.cta')}</Button>
        <Button href="/cv.pdf" variant="outline">{t('cta.downloadCv')}</Button>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section skills-strip">
    <div class="wrap tags">
      <Tag>{t('skills.marketing')}</Tag>
      <Tag>{t('skills.data')}</Tag>
      <Tag>{t('skills.supply')}</Tag>
      <Tag>{t('skills.bi')}</Tag>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t('projects.eyebrow')}</span>
          <h2>{t('projects.title')}</h2>
        </div>
        <a href="/es/projects" class="view-all">{t('projects.viewAll')} &rarr;</a>
      </div>

      <div class="cards-grid">
        {featuredProjects.map((p) => (
          <ProjectCard
            category={p.category}
            title={p.title}
            description={p.description}
            href={p.href}
            provisional={p.provisional}
            provisionalLabel="Ejemplo"
          />
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t('blog.eyebrow')}</span>
          <h2>{t('blog.title')}</h2>
        </div>
        <a href="/es/blog" class="view-all">{t('blog.viewBlog')} &rarr;</a>
      </div>

      <div class="articles-preview">
        {recentArticles.length === 0 ? (
          <p class="empty-articles">Nuevos artículos están en camino.</p>
        ) : (
          recentArticles.map((a) => (
            <a href="/es/blog" class="article-row">
              <Tag>{a.category}</Tag>
              <span class="article-row-title">{a.title}</span>
            </a>
          ))
        )}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section cta-final">
    <div class="wrap cta-inner">
      <h2>{t('cta.title')}</h2>
      <div class="cta-actions">
        <Button href="/es/contact">{t('cta.getInTouch')}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .hero-name {
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .hero-title {
    font-size: clamp(36px, 5.5vw, 56px);
    margin-top: 12px;
  }

  .hero-subtitle {
    margin-top: 24px;
    font-size: 18px;
    max-width: 52ch;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .section-head h2 {
    font-size: 30px;
    margin-top: 8px;
  }

  .view-all {
    font-size: 14px;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .articles-preview {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .article-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }

  .article-row-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-ink);
  }

  .empty-articles {
    color: var(--color-gray);
    font-size: 15px;
  }

  .cta-final {
    text-align: center;
    background: var(--color-paper);
  }

  .cta-inner h2 {
    font-size: clamp(26px, 3.5vw, 34px);
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-actions {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
