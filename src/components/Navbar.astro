---
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

// currentPath always comes in WITHOUT the /es prefix (see BaseLayout) so both
// language links can be built directly from it.
const enHref = currentPath === '/' ? '/' : currentPath;
const esHref = currentPath === '/' ? '/es' : `/es${currentPath}`;

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.blog', path: '/blog' },
  { key: 'nav.contact', path: '/contact' }
] as const;
---
<header class="navbar">
  <div class="wrap navbar-inner">
    <a href={localizedPath(lang, '/')} class="brand" aria-label="Stephanie Neyra">S.</a>

    <nav class="nav-links" aria-label="Main">
      {navItems.map((item) => (
        <a
          href={localizedPath(lang, item.path)}
          class:list={['nav-link', { active: currentPath === item.path }]}
        >
          {t(item.key)}
        </a>
      ))}
    </nav>

    <div class="lang-switch">
      <span class="lang-divider" aria-hidden="true">|</span>
      <a href={enHref} class:list={['lang-link', { active: lang === 'en' }]}>EN</a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a href={esHref} class:list={['lang-link', { active: lang === 'es' }]}>ES</a>
    </div>
  </div>
</header>

<style>
  .navbar {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 20;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 22px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1;
  }

  .nav-link {
    font-size: 14px;
    text-decoration: none;
    color: var(--color-gray);
  }

  .nav-link.active {
    color: var(--color-ink);
    font-weight: 500;
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .lang-divider {
    color: var(--color-border);
    margin-right: 8px;
  }

  .lang-link {
    text-decoration: none;
    color: var(--color-gray);
  }

  .lang-link.active {
    color: var(--color-ink);
    font-weight: 500;
  }

  .lang-sep {
    color: var(--color-border);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
  }
</style>
